<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no copiar credenciales ni caché en respaldos en la nube ni al migrar de teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
