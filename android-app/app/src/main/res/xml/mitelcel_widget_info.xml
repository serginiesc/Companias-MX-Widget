<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis=0: el refresco lo controla WorkManager (RefreshWorker), no el sistema.
    configure: pantalla que se abre al agregar el widget (elegir línea y transparencia).
    reconfigurable (Android 12+): mantener presionado el widget muestra "Configurar" para cambiarlo después.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="mx.mitelcel.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_mitelcel"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
