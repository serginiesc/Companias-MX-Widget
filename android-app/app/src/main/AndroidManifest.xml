<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para instalar actualizaciones descargadas de GitHub Releases (Android pide confirmación cada vez). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        allowBackup=false + dataExtractionRules: la contraseña cifrada NO debe viajar en respaldos.
        La llave de cifrado vive en el Android Keystore del teléfono y no se respalda, así que
        un respaldo restaurado en otro equipo sería inservible de todas formas.
    -->
    <application
        android:name=".MiTelcelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiTelcel">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El launcher la abre al agregar un widget: por eso exported=true y la acción APPWIDGET_CONFIGURE. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Tema básico del sistema (no AppCompat): debe abrir aunque el tema de la app sea el que falla. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Comparte el APK descargado con el instalador de Android (content://, permiso temporal). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <receiver
            android:name=".widget.MiTelcelWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mitelcel_widget_info" />
        </receiver>
    </application>
</manifest>
